# POPOPX Service Suite — deployment template.
#   cp .env.example .env      then edit .env      (never commit .env)
#
# Every key below is read by gateway/app/config.py; the names are the whole
# contract, and an unset key takes the documented default rather than failing.
# Values shown are the defaults unless marked REQUIRED.

# ─────────────────────────── the node (IPC seam) ───────────────────────────
# The open-source chat node exposes its WebSocket JSON API on loopback only,
# and only when started with --chat-server-port. Do not point this at a
# hostname: the node cannot serve one.
POPOPX_NODE_WS_URL=ws://127.0.0.1:5225
POPOPX_NODE_RECONNECT_SECONDS=3
POPOPX_NODE_COMMAND_TIMEOUT_SECONDS=30
# Enable the node's service-request channel (`/_start … service_requests=on`).
# Leave on: it is what lets a double-ratchet address answer a service request.
POPOPX_NODE_SERVICE_REQUESTS=1
# Send file messages through the node. Off unless the merchant needs attachments.
POPOPX_NODE_SEND_FILES=0
# Only read by docker-compose.yml, never by the gateway: the image the optional
# `node` service (compose profile "node") starts from. Build it from the node's
# own repository — this suite does not contain or link its code.
POPOPX_NODE_IMAGE=popopx-chat-node:local

# ─────────────────────────── gateway / console ─────────────────────────────
POPOPX_GATEWAY_HOST=0.0.0.0
POPOPX_GATEWAY_PORT=8080
# Public origin of THIS suite, as the phone will reach it. The gateway uses it
# to build the H5 urls handed to PopopxH5Launcher, which signs them and opens
# them in an out-of-process SFSafariViewController.
# Two facts that are easy to get wrong, both measured in the client:
#   * the signature covers only "uid=<pairwise_uid>&ts=<unix_seconds>"
#     (PopopxH5Launcher.swift:128-132) — NOT the host. A wrong origin here is a
#     reachability failure, never a signature mismatch.
#   * the launcher accepts http as well as https (PopopxH5Launcher.swift:52), so
#     a plain http://<LAN-IP>:<port> origin pairs with a real iPhone without any
#     app change. Use that for development only: the session secret's HMAC travels
#     in cleartext, and a phone on captive Wi-Fi leaks it to anyone on the segment.
# REQUIRED in production, where it must be https.
POPOPX_PUBLIC_BASE_URL=https://service.example.com

# ─────────────────────────── admin authentication ─────────────────────────
# Bearer token for every /api/v1/admin/** route and for the console.
# REQUIRED. generate with:  openssl rand -hex 32
# The gateway refuses to start with this unset, or left at any example value.
POPOPX_ADMIN_TOKEN=

# Shared secret the merchant's H5 pages present to /api/v1/verifyH5Auth when
# they call it server-to-server. Empty disables that path: the browser-side
# signature check still works, because it is keyed by the per-follower session
# secret, not by this.
# It is also the fallback key privacy_sso seals an SSO credential with when a
# follower has no usable pairwise session yet — so if you set it, set it to at
# least 16 bytes. 1 to 15 bytes is worse than empty: the gateway warns and the
# login still refuses. Generate with: openssl rand -hex 32
POPOPX_H5_SERVER_SECRET=

# ─────────────────────────── storage ───────────────────────────────────────
# One file holds everything: the ledger, the pairwise session secrets, the
# channel identity private keys and every epoch key. This is NOT a shortcut —
# `channel_key_update` must commit the new epoch and retire the old one in the
# same transaction as the card it delivers, and a second keyring file would make
# that a two-phase write whose failure mode is permanent: members holding a key
# the server can no longer sign rotations for. Back this up and nothing else.
# (The brief's POPOPX_KEYRING_PATH therefore has no setting here: there is no
# keyring file to point at. See gateway/app/config.py, storage block.)
POPOPX_DB_PATH=/var/lib/popopx-service-suite/gateway.db

# ─────────────────────────── service account identity ─────────────────────
# The display name the node's profile carries. Naming rule (see the client
# brief §4): a relay is never spelled as anything that reads like a VPN.
POPOPX_SERVICE_NAME=POPOPX 服务号
POPOPX_SERVICE_FULL_NAME=POPOPX Service Account
# The service's own id, echoed as `svc` in every session_handshake frame.
POPOPX_SERVICE_ID=popopx.official

# ─────────────────────────── POPX-CP quota (optional) ─────────────────────
# Base64 (standard, padded) of the raw 32-byte official Ed25519 *public* key
# that verifies activation codes. Mint codes with official_tools/gen_voucher.py
# holding the private half; the gateway must never see the private half.
# Leave empty: with the default below no code has to be redeemed to go live.
POPOPX_OFFICIAL_ED25519_PUBLIC_KEY=
# 0 (the default) = the account is created ONLINE and every plugin works out of
# the box; usage is still metered and recorded.
# 1 = admission mode: the account starts DRAFT, every metered action is refused
# with account_draft until a signed voucher is redeemed, and this key becomes
# REQUIRED (the gateway refuses to boot without it).
POPOPX_BILLING_REQUIRE_VOUCHER=0
# When the balance falls TO OR BELOW this the account is suspended (SUSPENDED) and
# every metered plugin is fused — the comparison is `balance <= threshold`, so with
# the default 0 the account fuses at exactly zero, not one credit after it.
# See billing_service.py.
POPOPX_BILLING_SUSPEND_THRESHOLD=0
# Per-action meter, in POPOPX Compute Credits (POPX-CP).
POPOPX_CP_PER_CARD=1
POPOPX_CP_PER_MENU_PUSH=1
POPOPX_CP_PER_KEY_ROTATION=2
POPOPX_CP_PER_AI_MESSAGE=5
POPOPX_CP_PER_ALERT=2
POPOPX_CP_PER_SSO_LOGIN=1
POPOPX_CP_PER_POLL=1
POPOPX_CP_PER_WEB3_EVENT=1
POPOPX_CP_PER_WORKFLOW_EVENT=1
POPOPX_CP_PER_CARDDAV_QUERY=1
POPOPX_CP_PER_CALDAV_QUERY=1
POPOPX_CP_PER_SLACK_DISCORD_EVENT=1

# ─────────────────────────── secrets at rest ───────────────────────────────
# Optional 32-byte key (64 hex characters or 44 base64 characters). When set,
# the gateway encrypts the pairwise session secrets, channel identity private
# keys, every channel epoch key, the workflow signing secrets and the DAV app
# passwords with ChaCha20-Poly1305 before they reach SQLite.
# Generate with: openssl rand -hex 32
# This is an OPERATOR-held key: losing it makes every sealed channel unreadable,
# and it is deliberately NOT derived from POPOPX_ADMIN_TOKEN. A value without
# the "vault1:" prefix is read as plaintext, so enabling the key does not
# require downtime; run `python3 -m app.main --migrate-secrets` once to seal the
# existing rows. Keep the key out of the database backup.
POPOPX_VAULT_KEY=

# ─────────────────────────── plugin switches ──────────────────────────────
# Each mounts its routes only when enabled; a disabled plugin answers 404.
# The plugins below ship OFF: an operator has to enable the plugin and
# then configure its endpoints/tokens in the console before anything leaves the
# gateway, and the outbound webhook signs every request with a per-subscription
# key generated at subscription time.
POPOPX_PLUGIN_AI_AGENT=1
POPOPX_PLUGIN_ALERT_OPS=1
POPOPX_PLUGIN_PRIVACY_SSO=1
POPOPX_PLUGIN_POLLS=1
POPOPX_PLUGIN_WEB3_BRIDGE=0
POPOPX_PLUGIN_WORKFLOW_WEBHOOK=0
POPOPX_PLUGIN_CARDDAV_CONNECTOR=0
POPOPX_PLUGIN_CALDAV_CONNECTOR=0
POPOPX_PLUGIN_SLACK_DISCORD=0

# ─────────────────────────── AI agent plugin ──────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint, including a local Ollama
# (http://127.0.0.1:11434/v1). Key stays on the merchant's server.
POPOPX_AI_BASE_URL=https://api.openai.com/v1
POPOPX_AI_API_KEY=
POPOPX_AI_MODEL=gpt-4o-mini
POPOPX_AI_MAX_TOKENS=512
POPOPX_AI_TIMEOUT_SECONDS=30
# System prompt. Kept short: it is billed into every reply's context.
POPOPX_AI_SYSTEM_PROMPT=你是 POPOPX 服务号的智能客服。回答简洁、礼貌，不索要任何个人身份信息。
# Per-follower rate limit, messages per window, to cap what one contact can burn.
POPOPX_AI_RATE_LIMIT_MESSAGES=20
POPOPX_AI_RATE_LIMIT_WINDOW_SECONDS=300

# ─────────────────────────── alert ops plugin ─────────────────────────────
# Shared secret for POST /api/v1/plugins/alerts/webhook (Prometheus/Grafana).
# REQUIRED to receive webhooks; empty rejects every call with 401.
POPOPX_ALERT_WEBHOOK_TOKEN=
# Optional second factor: when set, every alert webhook must also carry
#   X-Popopx-Timestamp: <unix seconds>
#   X-Popopx-Signature: v1=<hex HMAC-SHA256(secret, "<timestamp>.<raw body>")>
# Requests outside a ±300 s window, or a signature already seen inside it, are
# refused. Configure your sender to compute the header; without this value the
# token alone is accepted (the shipped behaviour before the signature existed).
POPOPX_ALERT_WEBHOOK_SECRET=
# Only these severities mint a red `security` card; anything else is logged.
POPOPX_ALERT_MIN_SEVERITY=warning
POPOPX_ALERT_RESOLVE_KEYWORDS=确认,已处理,ack,resolve

# ─────────────────────────── privacy SSO plugin ───────────────────────────
POPOPX_SSO_TTL_SECONDS=180
POPOPX_SSO_POLL_INTERVAL_MS=2000

# ─────────────────────────── web3 bridge plugin ───────────────────────────
# Public RPC endpoints; the plugin only ever reads them.
POPOPX_WEB3_EVM_RPC_URL=https://eth.llamarpc.com
POPOPX_WEB3_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
POPOPX_WEB3_POLL_INTERVAL_SECONDS=30

# ─────────────────────────── observability ────────────────────────────────
# DEBUG logs message bodies and is therefore not a production setting: the
# gateway holds pairwise session secrets and the frames that use them.
POPOPX_LOG_LEVEL=INFO
